# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Secret API authentication token for Telegram Bot @AviatorPredictorPro1Bot.
# Injected securely via server environment variables or Cloud Secrets.
# NEVER expose this token to the frontend client or bundle in client code.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# PAYSTACK_SECRET_KEY: Live secret key from Paystack Dashboard (sk_live_...).
# Injected securely via server environment variables.
# NEVER expose this secret key to the frontend client.
PAYSTACK_SECRET_KEY="sk_live_YOUR_PAYSTACK_LIVE_KEY"

# ADMIN_TELEGRAM_ID: Numeric Telegram ID for the system administrator/owner.
# Administrator automatically bypasses payment and receives full dashboard access.
ADMIN_TELEGRAM_ID="7760779963"

# TELEGRAM_COMMUNITY_LINK: Public invite link to official Telegram community.
TELEGRAM_COMMUNITY_LINK="https://t.me/AviatorPredictorProCommunity"

# TELEGRAM_COMMUNITY_CHAT_ID: Group or Channel Chat ID or username (@AviatorPredictorProCommunity).
# Required by Telegram Bot API to verify user membership via getChatMember.
TELEGRAM_COMMUNITY_CHAT_ID="@AviatorPredictorProCommunity"

# TELEGRAM_WEBHOOK_SECRET: Optional security token for validating incoming Telegram webhook requests.
TELEGRAM_WEBHOOK_SECRET="YOUR_TELEGRAM_WEBHOOK_SECRET"
